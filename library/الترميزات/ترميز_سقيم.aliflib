# punycode

استورد برمجيات_الترميز

دالة عزل(النص):
	قاعدة = مصفوفة_بايت()
	امتداد = مميزة()
	لكل ح في النص:
		اذا رمز(ح) < 128:
			قاعدة.اضف(رمز(ح))
		والا:
			امتداد.اضف(ح)
	امتداد = مرتب(امتداد)
	ارجع بايت(قاعدة), امتداد




دالة ترميز_مرمز_سقيم(النص): # 117
	قاعدة, امتداد = عزل(النص)
	ص = حقن_غير_مرتب(النص, امتداد)
	امتداد = ولد_اعداد(طول(قاعدة), ص)
	اذا قاعدة:
		ارجع قاعدة + ث"-" + امتداد
	ارجع امتداد










صنف الترميز(برمجيات_الترميز.الترميز):
	دالة ترميز(هذا, مدخل, اخطاء="strict"):
		ناتج = ترميز_مرمز_سقيم(مدخل)
		ارجع ناتج, طول(مدخل)
		
	دالة فك_ترميز(هذا, مدخل, اخطاء="strict"):
		اذا اخطاء ليس في ("strict", "replace", "ignore"):
			اطلق خطأ_ترميز(م"لم يستطع التعامل مع الخطأ: {اخطاء}")
		ناتج = فك_ترميز_مرمز_سقيم(مدخل, اخطاء)
		ارجع ناتج, طول(مدخل)

صنف مرمز_تزايدي(برمجيات_الترميز.مرمز_تزايدي):
	دالة ترميز(هذا, مدخل, النهاية= خطأ):
		ارجع ترميز_مرمز_سقيم(مدخل)
	
صنف فاك_ترميز_تزايدي(برمجيات_الترميز.فاك_ترميز_تزايدي):
	دالة فك_ترميز(هذا, مدخل, النهاية=خطأ):
		اذا هذا.اخطاء ليس في ("strict", "replace", "ignore"):
			اطلق خطأ_ترميز(م"لم يستطع التعامل مع الخطأ: {هذا.اخطاء}")
		ارجع فك_ترميز_مرمز_سقيم(مدخل, هذا.اخطاء)


صنف تدفق_الكتابة(الترميز, برمجيات_الترميز.تدفق_الكتابة):
	مرر

صنف تدفق_القراءة(الترميز, برمجيات_الترميز.تدفق_القراءة):
	مرر



دالة اجلب_مدخل_السجل():
	ارجع برمجيات_الترميز.معلومات_برمجية_الترميز(
	الاسم = "ترميز_سقيم",
	ترميز = الترميز().ترميز,
	فك_ترميز = الترميز().فك_ترميز,
	مرمز_تزايدي = مرمز_تزايدي,
	فاك_ترميز_تزايدي = فاك_ترميز_تزايدي,
	تدفق_القراءة=تدفق_القراءة,
	تدفق_الكتابة=تدفق_الكتابة,
	)